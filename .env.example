ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Hard spend cap in USD across all engines; calls abort once reached.
SPEND_CAP_USD=40
# Engine models (override if needed)
CLAUDE_ENGINE_MODEL=claude-opus-5-5
SIM_MODEL=claude-haiku-5-5
OPENAI_ENGINE_MODEL=gpt-5.5
PERPLEXITY_ENGINE_MODEL=sonar
# Flat per-call cost estimates (USD) for engines whose usage we can't price exactly
OPENAI_EST_COST_PER_CALL=0.06
PERPLEXITY_EST_COST_PER_CALL=0.01
